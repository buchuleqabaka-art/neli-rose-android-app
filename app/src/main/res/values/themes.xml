<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NeliRoseApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/neli_green</item>
        <item name="colorPrimaryVariant">@color/neli_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/neli_cream</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/neli_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
