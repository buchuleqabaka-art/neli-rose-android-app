<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neli_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Today's Vitals Card. Every field names its unit; empty fields are simply not saved. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Vitals" />

            <TextView
                android:id="@+id/tvLastVitals"
                style="@style/NeliBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No vitals saved yet" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/etBP"
                android:text="Blood pressure (mmHg)" />

            <EditText
                android:id="@+id/etBP"
                style="@style/NeliInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example 120/80"
                android:inputType="text" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etHR"
                android:text="Heart rate (beats per minute)" />

            <EditText
                android:id="@+id/etHR"
                style="@style/NeliInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example 72"
                android:inputType="number" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etTemp"
                android:text="Temperature (°C)" />

            <EditText
                android:id="@+id/etTemp"
                style="@style/NeliInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example 36.6"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etWeight"
                android:text="Weight (kg)" />

            <EditText
                android:id="@+id/etWeight"
                style="@style/NeliInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example 70"
                android:inputType="numberDecimal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveVitals"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Save Vitals"
                android:textColor="@color/neli_green" />
        </LinearLayout>

        <!-- Medical Schedule Card: the person's own medicines, each marked for today -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medical Schedule" />

            <TextView
                android:id="@+id/tvMedsEmpty"
                style="@style/NeliBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No medicines added yet. Use the button below to add one." />

            <LinearLayout
                android:id="@+id/containerMedications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMedication"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Add a medicine" />
        </LinearLayout>

        <!-- Hydration Tracker Card: starts at zero every day -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hydration Tracker" />

            <TextView
                android:id="@+id/tvHydrationProgressText"
                style="@style/NeliBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 of 8 glasses today" />

            <ProgressBar
                android:id="@+id/progressHydration"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="10dp"
                android:max="8"
                android:progress="0"
                android:progressDrawable="@drawable/progress_neli" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddGlass"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Add a glass of water" />
        </LinearLayout>

        <!-- Symptom Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log a Symptom" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="What are you feeling?" />

            <Spinner
                android:id="@+id/spinnerSymptoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@color/neli_light_green"
                android:contentDescription="Choose a symptom"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etSymptomNotes"
                android:text="Notes (optional)" />

            <EditText
                android:id="@+id/etSymptomNotes"
                style="@style/NeliInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example: started after lunch"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="300" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogSymptom"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Log Symptom" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Recently logged" />

            <TextView
                android:id="@+id/tvSymptomsEmpty"
                style="@style/NeliBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nothing logged yet" />

            <LinearLayout
                android:id="@+id/containerSymptoms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
