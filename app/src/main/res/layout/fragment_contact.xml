<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neli_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Quick Call Card: the person's own contacts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Call" />

            <TextView
                android:id="@+id/tvContactsEmpty"
                style="@style/NeliBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No contacts yet. Add one below." />

            <!-- Dynamic Contacts Container -->
            <LinearLayout
                android:id="@+id/containerQuickCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Add New Contact Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Contact" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@+id/etNewContactName"
                android:text="Name" />

            <EditText
                android:id="@+id/etNewContactName"
                style="@style/NeliInputGrey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example Sarah (daughter)"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="60" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etNewContactPhone"
                android:text="Phone number" />

            <EditText
                android:id="@+id/etNewContactPhone"
                style="@style/NeliInputGrey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example +27 82 123 4567"
                android:inputType="phone"
                android:maxLength="20" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddContact"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Add Contact" />
        </LinearLayout>

        <!-- Send a Message Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send a Message" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Send to" />

            <Spinner
                android:id="@+id/spinnerContactPeople"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@color/neli_grey"
                android:contentDescription="Choose who to message"
                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Message" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickMsg1"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="I'm doing well" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickMsg2"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Please call me" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendMessage"
                style="@style/NeliButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Send Message" />
        </LinearLayout>

        <!-- My Caregiver Card: the contact the person chose, not a fixed number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Caregiver" />

            <TextView
                android:id="@+id/tvCaregiverCardName"
                style="@style/NeliLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No caregiver chosen yet" />

            <TextView
                android:id="@+id/tvCaregiverCardHint"
                style="@style/NeliBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose one in the Quick Call list with the button &quot;Set as my caregiver&quot;." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallCaregiverCard"
                style="@style/NeliButtonGrey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Call my caregiver" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
