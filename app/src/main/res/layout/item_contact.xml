<?xml version="1.0" encoding="utf-8"?>
<!-- One contact in the Quick Call list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvContactName"
        style="@style/NeliLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvContactPhone"
        style="@style/NeliBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvContactBadge"
        style="@style/NeliLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/neli_light_green"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="Your caregiver"
        android:textColor="@color/neli_green" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContactCall"
        style="@style/NeliButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Call" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContactCaregiver"
        style="@style/NeliButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set as my caregiver" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContactEdit"
            style="@style/NeliButtonGrey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContactDelete"
            style="@style/NeliButtonGrey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/neli_grey" />
</LinearLayout>
