<?xml version="1.0" encoding="utf-8"?>
<!-- One activity request, used in "My requests" and in the care team's list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@color/neli_cream"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvRequestText"
        style="@style/NeliLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tvRequestMeta"
        style="@style/NeliBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRequestSeen"
        style="@style/NeliButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Mark as seen"
        android:visibility="gone" />
</LinearLayout>
