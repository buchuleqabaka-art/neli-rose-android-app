<?xml version="1.0" encoding="utf-8"?>
<!-- Edit a schedule event -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        style="@style/NeliLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@+id/etDialogEventTitle"
        android:text="What is it?" />

    <EditText
        android:id="@+id/etDialogEventTitle"
        style="@style/NeliInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:inputType="textCapSentences"
        android:maxLength="60" />

    <TextView
        style="@style/NeliLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:labelFor="@+id/etDialogEventNote"
        android:text="Note (optional)" />

    <EditText
        android:id="@+id/etDialogEventNote"
        style="@style/NeliInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:inputType="textCapSentences"
        android:maxLength="120" />

    <TextView
        android:id="@+id/tvDialogEventRepeat"
        style="@style/NeliBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="This event repeats every day." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogEventDate"
        style="@style/NeliButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Day" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogEventTime"
        style="@style/NeliButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Time" />
</LinearLayout>
