<?xml version="1.0" encoding="utf-8"?>
<!-- One event in the Schedule screen's list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowScheduleEvent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@color/neli_cream"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/tvEventTitle"
        style="@style/NeliLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvEventDetail"
        style="@style/NeliBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEventToggle"
        style="@style/NeliButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Mark as done" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEventEdit"
            style="@style/NeliButtonGrey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEventDelete"
            style="@style/NeliButtonGrey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Delete" />
    </LinearLayout>
</LinearLayout>
