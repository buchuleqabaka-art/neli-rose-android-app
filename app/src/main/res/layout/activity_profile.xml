<?xml version="1.0" encoding="utf-8"?>
<!-- Profile and settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neli_cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/neli_green"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="32dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/btnProfileBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="76dp"
            android:minHeight="56dp"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_back_triangle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="76dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile and settings"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- My details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/NeliCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My details" />

                <TextView
                    style="@style/NeliLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@+id/etProfileName"
                    android:text="Full name" />

                <EditText
                    android:id="@+id/etProfileName"
                    style="@style/NeliInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="60" />

                <TextView
                    style="@style/NeliLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:labelFor="@+id/etProfilePhone"
                    android:text="Phone number" />

                <EditText
                    android:id="@+id/etProfilePhone"
                    style="@style/NeliInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="for example +27 82 123 4567"
                    android:inputType="phone"
                    android:maxLength="20" />

                <TextView
                    style="@style/NeliLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Email (used to log in)" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    style="@style/NeliBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileSave"
                    style="@style/NeliButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Save my details" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/NeliCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings" />

                <TextView
                    style="@style/NeliLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Notifications" />

                <TextView
                    android:id="@+id/tvNotificationStatus"
                    style="@style/NeliBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableNotifications"
                    style="@style/NeliButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Turn on notifications" />

                <TextView
                    style="@style/NeliLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="My caregiver" />

                <TextView
                    android:id="@+id/tvProfileCaregiver"
                    style="@style/NeliBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Care team (only shown to caregiver accounts) -->
            <LinearLayout
                android:id="@+id/cardCareTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/NeliCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Care team" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCareRequests"
                    style="@style/NeliButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="See residents' activity requests" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileLogout"
                style="@style/NeliButtonGrey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log out" />

            <TextView
                android:id="@+id/tvAppVersion"
                style="@style/NeliBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
