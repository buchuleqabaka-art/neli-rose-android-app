<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neli_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Which day is shown. Each day keeps its own ticks. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvScheduleDate"
                style="@style/NeliCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Today" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevDay"
                    style="@style/NeliButtonGrey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Day before" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickDay"
                    style="@style/NeliButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Choose day" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextDay"
                    style="@style/NeliButtonGrey"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Day after" />
            </LinearLayout>
        </LinearLayout>

        <!-- Day Progress Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day Progress" />

            <TextView
                android:id="@+id/tvScheduleProgressText"
                style="@style/NeliBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nothing planned" />

            <ProgressBar
                android:id="@+id/progressSchedule"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_neli" />
        </LinearLayout>

        <!-- Events Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Events on this day" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@android:color/black" />

            <TextView
                android:id="@+id/tvScheduleEmpty"
                style="@style/NeliBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No events on this day. Add one below." />

            <LinearLayout
                android:id="@+id/containerScheduleEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Add New Event Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NeliCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Event" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:labelFor="@+id/etEventTitle"
                android:text="What is it?" />

            <EditText
                android:id="@+id/etEventTitle"
                style="@style/NeliInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example Morning Walk"
                android:inputType="textCapSentences"
                android:maxLength="60" />

            <TextView
                style="@style/NeliLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@+id/etEventNote"
                android:text="Note (optional)" />

            <EditText
                android:id="@+id/etEventNote"
                style="@style/NeliInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="for example bring a hat"
                android:inputType="textCapSentences"
                android:maxLength="120" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEventDate"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Day: today" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEventTime"
                style="@style/NeliButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Time: 09:00" />

            <CheckBox
                android:id="@+id/cbEventRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="56dp"
                android:text="Repeat every day"
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddEvent"
                style="@style/NeliButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Add event" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
